{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "specdriven-sync",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "SYNC_ROOM", "class_name": "SyncRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncRoom"] }],
  "vars": {
    // The GitHub whose repositories this server serves, and its REST API.
    "GITHUB_HOST": "github.com",
    "GITHUB_API_URL": "https://api.github.com",
    // How long a pass lasts, in seconds.
    "TICKET_SECONDS": "3600"
  }
  // TICKET_SECRET is a secret, not a var: `bunx wrangler secret put TICKET_SECRET`.
}
