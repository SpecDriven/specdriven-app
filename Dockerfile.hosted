# Hosted image (docs/deployment-railway.md): the gateway in front of one app
# server per user. Sign-in, the encrypted secrets and every user's folders
# live on the volume mounted at /data; nothing else in the image is state.
#
# The image starts as root: Railway mounts volumes owned by root, and root is
# what lets each user's worker run as a uid of its own (setpriv and prlimit,
# from util-linux in the base image), owning only that user's folder. That
# first process only starts and stops workers (src/gateway/spawner.ts); the
# gateway that answers requests is started by it as a uid that is not root
# (docs/hosted-tenant-isolation.md "Step 2"). No USER line: dropping root
# here would take the uids away.
FROM oven/bun:1.4-slim@sha256:1846adf22496bd711036aae8be147e57bdebbaea2e5264e3e0b5af1db187d9a4

# git for the system-git engine; without it the bundled JS engine is used.
RUN apt-get update \
  && apt-get install -y --no-install-recommends git ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json bun.lock ./
# --production skips devDependencies (electron and friends stay out).
RUN bun install --frozen-lockfile --production

COPY src ./src
# The What's new page bundles CHANGELOG.md (src/frontend/WhatsNewPage.tsx imports ../../CHANGELOG.md).
COPY CHANGELOG.md ./
# The demo dataset: a DEMO_MODE=1 service built from this image runs the public
# demo instead of the gateway (src/gateway/demo.ts).
COPY demo-data ./demo-data
# The app icon src/index.html links as its favicon; the bundler resolves it.
COPY build/icon.svg ./build/icon.svg
# The frontend, bundled once for every user: the gateway serves it, so the
# per-user workers never bundle it themselves (src/gateway/appShell.ts).
RUN bun build src/index.html --outdir dist/app --production --public-path /_app/

ENV NODE_ENV=production \
    SPECDRIVEN_DATA_DIR=/data \
    SPECDRIVEN_LOG_FILE=0 \
    PORT=3000

EXPOSE 3000

CMD ["bun", "src/gateway/index.ts"]
