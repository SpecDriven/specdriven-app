{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  // The build's output, and the desktop crash test's profile under dist/,
  // where the agent plugins it installs bring their own .ts tests.
  // The sync server's Cloudflare half is checked by its own tsconfig, against
  // the Workers types (cloudflare/sync-server); the rest of it is checked here.
  "exclude": [
    "node_modules",
    "dist",
    "release",
    "cloudflare/sync-server/node_modules",
    "cloudflare/sync-server/.wrangler",
    "cloudflare/sync-server/src/worker.ts"
  ]
}
