{
  "name": "sd_fable",
  "version": "0.1.0",
  "module": "src/index.ts",
  "main": "dist/electron/main.js",
  "type": "module",
  "private": true,
  "trustedDependencies": [
    "electron"
  ],
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun scripts/build.ts",
    "build:all": "bun scripts/build.ts --all",
    "dev:electron": "bun scripts/dev-electron.ts",
    "build:desktop": "bun scripts/build-desktop.ts",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "build": {
    "appId": "com.specdriven.app",
    "productName": "SpecDriven",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "SpecDriven spec link",
        "schemes": [
          "specdriven"
        ],
        "role": "Viewer"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@tanstack/react-table": "^8.21.3",
    "isomorphic-git": "^1.40.0",
    "minisearch": "^7.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
