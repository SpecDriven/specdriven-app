{
  "name": "specdriven",
  "version": "0.1.265",
  "description": "Enterprise spec-driven development workspace",
  "homepage": "https://github.com/SpecDriven/specdriven-app",
  "module": "src/index.ts",
  "main": "dist/electron/boot.js",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "desktopName": "specdriven.desktop",
  "trustedDependencies": [
    "electron"
  ],
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "dev:debug": "bun --inspect src/index.ts",
    "start": "bun src/index.ts",
    "demo": "DEMO_MODE=1 bun src/index.ts",
    "start:hosted": "bun src/gateway/index.ts",
    "dev:hosted": "SPECDRIVEN_DATA_DIR=${SPECDRIVEN_DATA_DIR:-.hosted-data} bun src/gateway/index.ts",
    "build": "bun scripts/build.ts",
    "build:all": "bun scripts/build.ts --all",
    "dev:electron": "bun scripts/dev-electron.ts",
    "build:desktop": "bun scripts/build-desktop.ts",
    "build:icons": "bun scripts/build-icons.ts",
    "test:desktop": "bun scripts/crash-test-desktop.ts",
    "bump": "bun scripts/bump-version.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "jscpd": "^5.4.2",
    "knip": "^6.44.1",
    "ts-morph": "^28.0.0",
    "ws": "^8.22.1"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.specdriven.app",
    "productName": "SpecDriven",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "files": [
      "dist/electron/**",
      "dist/renderer/**",
      "dist/icon.png",
      "dist/patch.json",
      "!dist/**/*.map",
      "package.json",
      "LICENSE.md",
      "NOTICE.md",
      "!node_modules/**"
    ],
    "asarUnpack": [
      "dist/electron/cbor-extract/**"
    ],
    "electronLanguages": [
      "en"
    ],
    "protocols": [
      {
        "name": "SpecDriven spec link",
        "schemes": [
          "specdriven"
        ],
        "role": "Viewer"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "notarize": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "format": "ULFO"
    },
    "linux": {
      "icon": "build/icons",
      "category": "Development",
      "maintainer": "SpecDriven <hello@specdriven.app>",
      "executableName": "specdriven",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2"
      ]
    }
  },
  "dependencies": {
    "@automerge/automerge": "^3.5.0",
    "@automerge/automerge-repo": "^2.6.0-alpha.3",
    "@automerge/automerge-repo-network-websocket": "^2.6.0-alpha.3",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@replit/codemirror-vim": "^6.4.0",
    "just-git": "^1.10.0",
    "lucide-react": "^1.66.0",
    "minisearch": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "nanoid": "^3.3.19",
    "lodash-es": "^4.18.1",
    "@automerge/automerge": "^3.5.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@codemirror/language": "^6.13.1",
    "@codemirror/autocomplete": "^6.20.4",
    "@lezer/common": "^1.5.0",
    "@lezer/highlight": "^1.2.5",
    "@lezer/lr": "^1.4.2",
    "sass": "^1.105.1",
    "hono": "^4.13.11",
    "proxy-addr": "^2.0.8",
    "source-map-js": "^1.2.2",
    "global-agent": "^4.1.3",
    "katex": "^0.18.11",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dompurify": "^3.4.17",
    "ip-address": "^10.7.4",
    "body-parser": "^2.4.0",
    "fast-uri": "^3.1.9"
  }
}
