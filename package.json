{
  "name": "specdriven",
  "version": "0.1.127",
  "description": "Enterprise spec-driven development workspace",
  "homepage": "https://github.com/SpecDriven/specdriven-app-release",
  "module": "src/index.ts",
  "main": "dist/electron/main.js",
  "type": "module",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "desktopName": "specdriven.desktop",
  "trustedDependencies": [
    "electron"
  ],
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "dev:debug": "bun --inspect src/index.ts",
    "start": "bun src/index.ts",
    "demo": "DEMO_MODE=1 bun src/index.ts",
    "start:hosted": "bun src/gateway/index.ts",
    "dev:hosted": "SPECDRIVEN_DATA_DIR=${SPECDRIVEN_DATA_DIR:-.hosted-data} bun src/gateway/index.ts",
    "build": "bun scripts/build.ts",
    "build:all": "bun scripts/build.ts --all",
    "dev:electron": "bun scripts/dev-electron.ts",
    "build:desktop": "bun scripts/build-desktop.ts",
    "test:desktop": "bun scripts/crash-test-desktop.ts",
    "bump": "bun scripts/bump-version.ts",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "electron": "^43.7.7",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.14.5",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.specdriven.app",
    "productName": "SpecDriven",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE.md",
      "NOTICE.md",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "protocols": [
      {
        "name": "SpecDriven spec link",
        "schemes": [
          "specdriven"
        ],
        "role": "Viewer"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "notarize": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Development",
      "maintainer": "SpecDriven <hello@specdriven.app>",
      "executableName": "specdriven",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2"
      ]
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.261",
    "@automerge/automerge": "^3.5.0",
    "@automerge/automerge-repo": "^2.6.0-alpha.3",
    "@automerge/automerge-repo-network-websocket": "^2.6.0-alpha.3",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@replit/codemirror-vim": "^6.4.0",
    "@tanstack/react-table": "^8.21.3",
    "just-git": "^1.9.0",
    "lucide-react": "^1.50.0",
    "minisearch": "^7.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "overrides": {
    "nanoid": "^3.3.19",
    "lodash-es": "^4.18.1",
    "@automerge/automerge": "^3.5.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "sass": "^1.105.1",
    "proxy-addr": "^2.0.8",
    "source-map-js": "^1.2.2",
    "global-agent": "^4.1.3",
    "katex": "^0.18.11",
    "@modelcontextprotocol/sdk": "^1.31.0"
  }
}
